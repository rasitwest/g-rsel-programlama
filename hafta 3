        private void Form1_KeyPress(object sender, KeyPressEventArgs e)
        {
            // Basılan tuşu öğren
            char tus = e.KeyChar;

            // ASCII değerini öğren
            byte ascii = (byte)tus;

            // Label üzerinde göster
            label1.Text = "Basılan Tuş: " + tus.ToString()
                + " , ASCII Değeri: " + ascii.ToString();

            // ASCII değeri 24 ise programdan çık
            if (ascii == 24)
            {
                Application.Exit();
            }
            private void Form1_KeyDown(object sender, KeyEventArgs);
            {//Bir tuş aşağa olayı oldu :
                label2.Text =
                    $"KeyCode:{e.KeyCode}\n"
                    +$"KeyCode:{e.KeyData}\n"
                    +$"KeyCode:{e.KeyValue}\n"
                /* KeyCode : Klavyede tuşlardan hangisine basıldı.
                 * KeyData : KeyCode ile birlikte (CTRL,ALT,SHİFT)
                 * tuşlarından hangisine basıldığını verir.
                 * KeyValue : Tuş kombinasyonunun (CTRL-X) ascii değerini
                 * verir.
                 */
                if (e.Control) label3.Text = "CTRL";
                else if (e.Shift) label3.Text = "SHIFT";
                else if (e.Alt) Label3.text = "ALT";

                if(e.Control) // eğer CTRL Basıldıysa
                {
                    if(e.KeyCode==Keys.CapsLock)
                    {//Eğer caps lock basıldıysa 
                        this.Close();

                }


        }

    }
